{
  "name": "azfit-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "Runs AZfit's coaching jobs through the user's own signed-in Claude Code (claude -p).",
  "type": "module",
  "engines": {
    "node": ">=23.6"
  },
  "scripts": {
    "start": "node src/main.ts start",
    "pair": "node src/main.ts pair",
    "reset-token": "node src/main.ts reset-token",
    "review": "node src/cli.ts review",
    "eval": "node test/eval.ts",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "meal": "node src/cli.ts meal",
    "session": "node src/cli.ts session"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.5",
    "typescript": "^5.8.0"
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  }
}
